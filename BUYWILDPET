
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local TWEEN_SPEED = 50
local HEIGHT_OFFSET = 3
local WAIT_AFTER_TWEEN = 0.2
local RESCAN_DELAY = 1

--------------------------------------------------
-- FOLDERS
--------------------------------------------------

local PartyLeaves = workspace:WaitForChild("PartyLeaves")
local PartyPointDrops = workspace:WaitForChild("PartyPointDrops")
local DiscoPartyPoint = workspace:WaitForChild("DiscoPartyPoint")

--------------------------------------------------
-- GET CHARACTER
--------------------------------------------------

local function GetCharacter()
    return Player.Character or Player.CharacterAdded:Wait()
end

--------------------------------------------------
-- GET ALL PARTS
--------------------------------------------------

local function GetAllParts()
    local parts = {}

    local folders = {
        PartyLeaves,
        PartyPointDrops,
        DiscoPartyPoint
    }

    for _, folder in ipairs(folders) do
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("BasePart") then
                table.insert(parts, obj)
            end
        end
    end

    return parts
end

--------------------------------------------------
-- FIND NEAREST PART
--------------------------------------------------

local function GetNearestPart(parts, position)
    local nearestPart = nil
    local nearestDistance = math.huge

    for _, part in ipairs(parts) do
        if part and part.Parent then
            local distance = (part.Position - position).Magnitude

            if distance < nearestDistance then
                nearestDistance = distance
                nearestPart = part
            end
        end
    end

    return nearestPart
end

--------------------------------------------------
-- TWEEN TO PART
--------------------------------------------------

local function TweenToPart(part)
    local Character = GetCharacter()
    local HRP = Character:FindFirstChild("HumanoidRootPart")

    if not HRP or not part then
        return false
    end

    local distance = (HRP.Position - part.Position).Magnitude

    local duration = distance / TWEEN_SPEED

    local targetCFrame =
        part.CFrame + Vector3.new(0, HEIGHT_OFFSET, 0)

    local tween = TweenService:Create(
        HRP,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            CFrame = targetCFrame
        }
    )

    tween:Play()
    tween.Completed:Wait()

    return true
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do

    local parts = GetAllParts()

    while #parts > 0 do

        local Character = GetCharacter()
        local HRP = Character:FindFirstChild("HumanoidRootPart")

        if not HRP then
            break
        end

        --------------------------------------------------
        -- CARI PART TERDEKAT
        --------------------------------------------------

        local nearestPart = GetNearestPart(
            parts,
            HRP.Position
        )

        if not nearestPart then
            break
        end

        --------------------------------------------------
        -- TWEEN
        --------------------------------------------------

        TweenToPart(nearestPart)

        --------------------------------------------------
        -- HAPUS DARI LIST
        --------------------------------------------------

        for i, part in ipairs(parts) do
            if part == nearestPart then
                table.remove(parts, i)
                break
            end
        end

        task.wait(WAIT_AFTER_TWEEN)
    end

    --------------------------------------------------
    -- SEMUA PART SUDAH DIKUNJUNGI
    -- SCAN ULANG
    --------------------------------------------------

    task.wait(RESCAN_DELAY)
end
