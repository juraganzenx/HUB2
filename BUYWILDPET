--==================================================
-- AUTO TAKE ALL PET
-- DROP ALL PET
-- TWEEN TO CHARLOTTE IF NO PET
--
-- LOGIC:
-- 1. SCAN SEMUA WILD PET
-- 2. CEK HARGA PET DARI BuyPrompt.ObjectText
-- 3. HARGA >= 12,000,000 -> SKIP
-- 4. HARGA < 12,000,000 -> KEJAR PET
-- 5. TWEEN TERUS MENGIKUTI RootPart PET
-- 6. JIKA SUDAH DEKAT -> FIRE BuyPrompt
-- 7. SETELAH PROMPT DIPANGGIL -> STOP MENGIKUTI PET
-- 8. LANJUT KE PET BERIKUTNYA
-- 9. DROP SEMUA PET
-- 10. RACCOON DI BACKPACK TIDAK DI-DROP
-- 11. JIKA TIDAK ADA WILD PET -> TWEEN KE CHARLOTTE
-- 12. ULANGI TERUS
--
-- SERVER HOP DIHAPUS
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local Networking = require(
    ReplicatedStorage.SharedModules.Networking
)

--==================================================
-- CONFIG
--==================================================

-- Kecepatan Tween
local TWEEN_SPEED = 100

-- Interval Main Loop
local CHECK_DELAY = 2

-- Jarak dianggap sudah sampai ke pet
local PET_REACH_DISTANCE = 5

-- Seberapa sering target RootPart diperbarui
local TWEEN_UPDATE_DELAY = 0.1

-- Harga maksimal
--
-- Jika harga >= 12,000,000
-- maka pet tidak akan dibeli
local MAX_PET_PRICE = 12000000

-- Timeout Equip Pet
local EQUIP_TIMEOUT = 5

-- Timeout Drop Pet
local DROP_TIMEOUT = 5

-- Delay setelah prompt dipanggil
local AFTER_TAKE_DELAY = 0.2

-- Delay setelah proses pet
local AFTER_PROCESS_DELAY = 0.5

-- Delay setelah drop pet
local AFTER_DROP_DELAY = 0.5

--==================================================
-- PATH WILD PET
--==================================================

local WildPetSpawns = workspace
    :WaitForChild("Map")
    :WaitForChild("WildPetSpawns")

--==================================================
-- VARIABLES
--==================================================

local Batch = {}

local ProcessingBatch = false

local TweeningToCenter = false

--==================================================
-- GET CHARACTER
--==================================================

local function GetCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

end

--==================================================
-- GET ROOT
--==================================================

local function GetRoot()

    local Character = GetCharacter()

    return Character:WaitForChild(
        "HumanoidRootPart"
    )

end

--==================================================
-- GET PET PRICE
--
-- Contoh:
--
-- ObjectText:
-- ¢50,000
--
-- Hasil:
-- 50000
--==================================================

local function GetPetPrice(BuyPrompt)

    if not BuyPrompt then

        return nil

    end

    local ObjectText =
        BuyPrompt.ObjectText or ""

    if ObjectText == "" then

        return nil

    end

    --==================================================
    -- AMBIL SEMUA ANGKA
    --
    -- ¢50,000
    -- menjadi
    -- 50000
    --
    -- ¢12,000,000
    -- menjadi
    -- 12000000
    --==================================================

    local PriceText =
        ObjectText:gsub(
            "[^%d]",
            ""
        )

    if PriceText == "" then

        return nil

    end

    local PetPrice =
        tonumber(
            PriceText
        )

    return PetPrice

end

--==================================================
-- ADD PET KE BATCH
--==================================================

local function AddToBatch(Pet)

    if not Pet
        or not Pet.Parent then

        return

    end

    --==================================================
    -- CEGAH DUPLIKAT
    --==================================================

    for _, ExistingPet in ipairs(
        Batch
    ) do

        if ExistingPet == Pet then

            return

        end

    end

    --==================================================
    -- TAMBAHKAN KE BATCH
    --==================================================

    table.insert(
        Batch,
        Pet
    )

end

--==================================================
-- SCAN SEMUA PET
--==================================================

local function ScanAllPets()

    for _, Pet in ipairs(
        WildPetSpawns:GetChildren()
    ) do

        AddToBatch(
            Pet
        )

    end

end

--==================================================
-- TAKE / BUY PET
--
-- TWEEN AKAN TERUS MENGIKUTI RootPart
--
-- Jika pet bergerak:
-- posisi target diperbarui
--
-- Jika sudah dekat:
-- fireproximityprompt()
--
-- Setelah prompt:
-- berhenti mengikuti pet
--==================================================

local function TakePet(Pet)

    --==================================================
    -- CEK PET
    --==================================================

    if not Pet
        or not Pet.Parent then

        return false

    end

    --==================================================
    -- GET ROOT PART
    --==================================================

    local RootPart =
        Pet:FindFirstChild(
            "RootPart"
        )

    if not RootPart then

        return false

    end

    --==================================================
    -- GET BUY PROMPT
    --==================================================

    local BuyPrompt =
        RootPart:FindFirstChild(
            "BuyPrompt"
        )

    if not BuyPrompt
        or not BuyPrompt:IsA(
            "ProximityPrompt"
        ) then

        return false

    end

    --==================================================
    -- CEK HARGA
    --==================================================

    local PetPrice =
        GetPetPrice(
            BuyPrompt
        )

    --==================================================
    -- GAGAL BACA HARGA
    -- SKIP
    --==================================================

    if not PetPrice then

        return false

    end

    --==================================================
    -- JANGAN BELI JIKA:
    --
    -- Harga >= 12,000,000
    --==================================================

    if PetPrice >= MAX_PET_PRICE then

        return false

    end

    --==================================================
    -- GET PLAYER ROOT
    --==================================================

    local HRP =
        GetRoot()

    --==================================================
    -- LOOP KEJAR PET
    --==================================================

    while Pet.Parent
        and RootPart.Parent
        and BuyPrompt.Parent do

        --==================================================
        -- HITUNG JARAK TERBARU
        --==================================================

        local Distance = (
            HRP.Position
            - RootPart.Position
        ).Magnitude

        --==================================================
        -- SUDAH DEKAT PET
        --==================================================

        if Distance <= PET_REACH_DISTANCE then

            break

        end

        --==================================================
        -- HITUNG DURASI TWEEN
        --
        -- SPEED = 100
        --==================================================

        local Duration =
            Distance / TWEEN_SPEED

        --==================================================
        -- BUAT TWEEN KE POSISI TERBARU
        --==================================================

        local Tween =
            TweenService:Create(

                HRP,

                TweenInfo.new(
                    math.max(
                        Duration,
                        0.05
                    ),

                    Enum.EasingStyle.Linear,

                    Enum.EasingDirection.Out
                ),

                {
                    CFrame =
                        RootPart.CFrame
                }

            )

        --==================================================
        -- PLAY TWEEN
        --==================================================

        Tween:Play()

        --==================================================
        -- TUNGGU SEBENTAR
        --
        -- Setelah 0.1 detik:
        -- cek posisi pet lagi
        --==================================================

        task.wait(
            TWEEN_UPDATE_DELAY
        )

        --==================================================
        -- CANCEL TWEEN LAMA
        --
        -- Agar target bisa diperbarui
        --==================================================

        if Tween.PlaybackState
            == Enum.PlaybackState.Playing then

            Tween:Cancel()

        end

    end

    --==================================================
    -- CEK PET MASIH VALID
    --==================================================

    if not Pet.Parent
        or not RootPart.Parent
        or not BuyPrompt.Parent then

        return false

    end

    --==================================================
    -- UPDATE POSISI TERAKHIR
    --==================================================

    HRP.CFrame =
        RootPart.CFrame

    --==================================================
    -- FIRE BUY PROMPT
    --==================================================

    local Success =
        pcall(function()

            fireproximityprompt(
                BuyPrompt
            )

        end)

    --==================================================
    -- PROMPT BERHASIL DIPANGGIL
    --
    -- STOP MENGIKUTI PET
    --==================================================

    if Success then

        task.wait(
            AFTER_TAKE_DELAY
        )

        return true

    end

    return false

end

--==================================================
-- PROCESS SEMUA PET DALAM BATCH
--==================================================

local function ProcessBatch()

    if ProcessingBatch then

        return

    end

    if #Batch == 0 then

        return

    end

    ProcessingBatch = true

    --==================================================
    -- PROSES SATU PER SATU
    --==================================================

    while #Batch > 0 do

        local Pet =
            table.remove(
                Batch,
                1
            )

        --==================================================
        -- CEK PET MASIH ADA
        --==================================================

        if Pet
            and Pet.Parent then

            --==================================================
            -- TAKE / SKIP PET
            --==================================================

            TakePet(
                Pet
            )

            --==================================================
            -- JEDA SEBELUM PET BERIKUTNYA
            --==================================================

            task.wait(
                AFTER_PROCESS_DELAY
            )

        end

    end

    ProcessingBatch = false

end

--==================================================
-- GET SEMUA PET YANG DIMILIKI
--
-- BACKPACK + CHARACTER
--==================================================

local function GetAllOwnedPets()

    local Pets = {}

    --==================================================
    -- GET BACKPACK
    --==================================================

    local Backpack =
        LocalPlayer:WaitForChild(
            "Backpack"
        )

    --==================================================
    -- SCAN BACKPACK
    --==================================================

    for _, Item in ipairs(
        Backpack:GetChildren()
    ) do

        if Item:GetAttribute(
            "Pet"
        ) ~= nil then

            table.insert(
                Pets,
                Item
            )

        end

    end

    --==================================================
    -- GET CHARACTER
    --==================================================

    local Character =
        LocalPlayer.Character

    --==================================================
    -- SCAN CHARACTER
    --==================================================

    if Character then

        for _, Item in ipairs(
            Character:GetChildren()
        ) do

            if Item:GetAttribute(
                "Pet"
            ) ~= nil then

                table.insert(
                    Pets,
                    Item
                )

            end

        end

    end

    return Pets

end

--==================================================
-- EQUIP PET
--==================================================

local function EquipPet(Pet)

    local Character =
        GetCharacter()

    --==================================================
    -- SUDAH EQUIP
    --==================================================

    if Pet.Parent
        == Character then

        return true

    end

    --==================================================
    -- PET HARUS DI BACKPACK
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Backpack then

        return false

    end

    --==================================================
    -- GET HUMANOID
    --==================================================

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then

        return false

    end

    --==================================================
    -- EQUIP
    --==================================================

    Humanoid:EquipTool(
        Pet
    )

    --==================================================
    -- TUNGGU SAMPAI MASUK CHARACTER
    --==================================================

    local StartTime =
        os.clock()

    while os.clock()
        - StartTime
        < EQUIP_TIMEOUT do

        if Pet.Parent
            == Character then

            return true

        end

        task.wait(
            0.1
        )

    end

    return false

end

--==================================================
-- DROP SATU PET
--==================================================

local function DropPet(Pet)

    if not Pet then

        return false

    end

    --==================================================
    -- GET PET ID
    --==================================================

    local PetId =
        Pet:GetAttribute(
            "PetId"
        )

    if not PetId then

        return false

    end

    --==================================================
    -- EQUIP JIKA MASIH DI BACKPACK
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Character then

        local Equipped =
            EquipPet(
                Pet
            )

        if not Equipped then

            return false

        end

    end

    --==================================================
    -- PASTIKAN SUDAH DI CHARACTER
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Character then

        return false

    end

    --==================================================
    -- REQUEST DROP
    --==================================================

    local Success =
        pcall(function()

            Networking
                .DroppedItem
                .RequestDrop
                :Fire(
                    "Pets",
                    PetId
                )

        end)

    if not Success then

        return false

    end

    --==================================================
    -- TUNGGU PET HILANG
    --==================================================

    local StartTime =
        os.clock()

    while os.clock()
        - StartTime
        < DROP_TIMEOUT do

        if not Pet.Parent then

            return true

        end

        task.wait(
            0.1
        )

    end

    return false

end

--==================================================
-- DROP SEMUA PET
--
-- RACCOON DI BACKPACK:
-- TIDAK DI-DROP
--==================================================

local function DropAllPets()

    --==================================================
    -- SCAN PET
    --==================================================

    local Pets =
        GetAllOwnedPets()

    --==================================================
    -- TIDAK ADA PET
    --==================================================

    if #Pets == 0 then

        return

    end

    --==================================================
    -- DROP SATU PER SATU
    --==================================================

    for _, Pet in ipairs(
        Pets
    ) do

        if Pet
            and Pet.Parent then

            --==================================================
            -- GET PET NAME
            --==================================================

            local PetName =
                Pet:GetAttribute(
                    "Pet"
                )

            --==================================================
            -- CEK RACCOON DI BACKPACK
            --==================================================

            local IsRaccoonInBackpack =
                PetName == "Raccoon"
                and Pet.Parent
                    == LocalPlayer.Backpack

            --==================================================
            -- JIKA BUKAN RACCOON DI BACKPACK
            -- DROP
            --==================================================

            if not IsRaccoonInBackpack then

                DropPet(
                    Pet
                )

                task.wait(
                    AFTER_DROP_DELAY
                )

            end

        end

    end

end

--==================================================
-- TWEEN KE CHARLOTTE
--
-- TARGET:
-- workspace.NPCS.Charlotte.HumanoidRootPart
--
-- SPEED:
-- 100
--==================================================

local function TweenToCenterMap()

    --==================================================
    -- CEGAH TWEEN GANDA
    --==================================================

    if TweeningToCenter then

        return

    end

    TweeningToCenter = true

    --==================================================
    -- GET PLAYER ROOT
    --==================================================

    local HRP =
        GetRoot()

    --==================================================
    -- GET CHARLOTTE
    --==================================================

    local Charlotte =
        workspace
        :WaitForChild(
            "NPCS"
        )
        :WaitForChild(
            "Charlotte"
        )

    --==================================================
    -- GET ROOT CHARLOTTE
    --==================================================

    local CharlotteRoot =
        Charlotte:WaitForChild(
            "HumanoidRootPart"
        )

    --==================================================
    -- HITUNG JARAK
    --==================================================

    local Distance = (
        HRP.Position
        - CharlotteRoot.Position
    ).Magnitude

    --==================================================
    -- SUDAH DEKAT
    --==================================================

    if Distance <= 2 then

        TweeningToCenter = false

        return

    end

    --==================================================
    -- DURASI TWEEN
    --==================================================

    local Duration =
        Distance / TWEEN_SPEED

    --==================================================
    -- TWEEN KE CHARLOTTE
    --==================================================

    local Tween =
        TweenService:Create(

            HRP,

            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CharlotteRoot.CFrame
            }

        )

    Tween:Play()

    Tween.Completed:Wait()

    --==================================================
    -- SELESAI
    --==================================================

    TweeningToCenter = false

end

--==================================================
-- PET BARU MASUK WILD PET SPAWNS
--==================================================

WildPetSpawns.ChildAdded:Connect(
    function(Pet)

        task.wait(
            0.1
        )

        AddToBatch(
            Pet
        )

    end
)

--==================================================
-- MAIN LOOP
--==================================================

while task.wait(
    CHECK_DELAY
) do

    --==================================================
    -- STEP 1
    -- SCAN SEMUA PET
    --==================================================

    ScanAllPets()

    --==================================================
    -- STEP 2
    -- TAKE SEMUA PET
    --
    -- TWEEN TERUS MENGIKUTI RootPart
    --==================================================

    ProcessBatch()

    --==================================================
    -- STEP 3
    -- DROP SEMUA PET
    --
    -- RACCOON DI BACKPACK DI-SKIP
    --==================================================

    DropAllPets()

    --==================================================
    -- STEP 4
    -- SCAN ULANG
    --==================================================

    ScanAllPets()

    --==================================================
    -- STEP 5
    -- JIKA TIDAK ADA PET
    -- TWEEN KE CHARLOTTE
    --==================================================

    if #WildPetSpawns:GetChildren() == 0
        and #Batch == 0
        and not ProcessingBatch then

        TweenToCenterMap()

    end

end
