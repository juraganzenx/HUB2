--BUYWILDPET SEKARANG
--==================================================
-- AUTO TAKE ALL PET
-- DROP ALL PET
-- TWEEN TO CHARLOTTE IF NO PET
--
-- LOGIC:
-- 1. SCAN SEMUA WILD PET
-- 2. CEK HARGA DARI BuyPrompt.ObjectText
-- 3. JIKA HARGA >= 12,000,000 -> SKIP
-- 4. JIKA HARGA < 12,000,000 -> TWEEN KE PET
-- 5. FIRE BUY PROMPT
-- 6. SETELAH PROMPT DIPANGGIL -> STOP MENGIKUTI PET
-- 7. LANJUT KE PET BERIKUTNYA
-- 8. DROP SEMUA PET
-- 9. RACCOON DI BACKPACK TIDAK DI-DROP
-- 10. JIKA TIDAK ADA PET -> TWEEN KE CHARLOTTE
-- 11. ULANGI TERUS
--
-- SERVER HOP DIHAPUS
--==================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

local Networking = require(
    ReplicatedStorage.SharedModules.Networking
)

--==================================================
-- CONFIG
--==================================================

-- Kecepatan Tween
local TWEEN_SPEED = 100

-- Maksimal harga pet yang boleh dibeli
-- Harga >= 12,000,000 akan di-SKIP
local MAX_PET_PRICE = 20000000

-- Interval Main Loop
local CHECK_DELAY = 2

-- Timeout Equip Pet
local EQUIP_TIMEOUT = 5

-- Timeout Drop Pet
local DROP_TIMEOUT = 5

-- Delay setelah prompt dipanggil
local AFTER_TAKE_DELAY = 0.2

-- Delay setelah selesai proses satu pet
local AFTER_PROCESS_DELAY = 0.5

-- Delay setelah drop satu pet
local AFTER_DROP_DELAY = 0.5

--==================================================
-- PATH WILD PET
--==================================================

local WildPetSpawns = workspace
    :WaitForChild("Map")
    :WaitForChild("WildPetSpawns")

--==================================================
-- VARIABLES
--==================================================

local Batch = {}

local ProcessingBatch = false

local TweeningToCenter = false

--==================================================
-- GET CHARACTER
--==================================================

local function GetCharacter()

    return LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

end

--==================================================
-- GET ROOT
--==================================================

local function GetRoot()

    local Character = GetCharacter()

    return Character:WaitForChild(
        "HumanoidRootPart"
    )

end

--==================================================
-- PARSE HARGA DARI OBJECTTEXT
--
-- CONTOH:
-- ¢50,000
-- ¢1,500,000
-- ¢12,000,000
--
-- HASIL:
-- 50000
-- 1500000
-- 12000000
--==================================================

local function GetPetPrice(BuyPrompt)

    if not BuyPrompt then
        return nil
    end

    local ObjectText =
        BuyPrompt.ObjectText or ""

    if ObjectText == "" then
        return nil
    end

    --==================================================
    -- AMBIL HANYA ANGKA
    --
    -- ¢50,000
    -- menjadi:
    -- 50000
    --==================================================

    local PriceText =
        ObjectText:gsub(
            "[^%d]",
            ""
        )

    if PriceText == "" then
        return nil
    end

    local PetPrice =
        tonumber(
            PriceText
        )

    return PetPrice

end

--==================================================
-- ADD PET TO BATCH
--==================================================

local function AddToBatch(Pet)

    if not Pet
        or not Pet.Parent then

        return

    end

    --==================================================
    -- CEGAH PET DUPLIKAT
    --==================================================

    for _, ExistingPet in ipairs(Batch) do

        if ExistingPet == Pet then

            return

        end

    end

    --==================================================
    -- TAMBAHKAN KE BATCH
    --==================================================

    table.insert(
        Batch,
        Pet
    )

end

--==================================================
-- SCAN SEMUA PET
--==================================================

local function ScanAllPets()

    for _, Pet in ipairs(
        WildPetSpawns:GetChildren()
    ) do

        AddToBatch(
            Pet
        )

    end

end

--==================================================
-- TAKE / BUY PET
--
-- HARGA >= 12,000,000
-- -> SKIP
--
-- HARGA < 12,000,000
-- -> BELI
--==================================================

local function TakePet(Pet)

    --==================================================
    -- CEK PET
    --==================================================

    if not Pet
        or not Pet.Parent then

        return false

    end

    --==================================================
    -- GET ROOT PART
    --==================================================

    local RootPart =
        Pet:FindFirstChild(
            "RootPart"
        )

    if not RootPart then

        return false

    end

    --==================================================
    -- GET BUY PROMPT
    --==================================================

    local BuyPrompt =
        RootPart:FindFirstChild(
            "BuyPrompt"
        )

    if not BuyPrompt
        or not BuyPrompt:IsA(
            "ProximityPrompt"
        ) then

        return false

    end

    --==================================================
    -- CEK HARGA PET
    --==================================================

    local PetPrice =
        GetPetPrice(
            BuyPrompt
        )

    --==================================================
    -- JIKA GAGAL BACA HARGA
    -- SKIP AGAR AMAN
    --==================================================

    if not PetPrice then

        warn(
            "[SKIP PET] Gagal membaca harga:",
            Pet.Name,
            "ObjectText:",
            BuyPrompt.ObjectText
        )

        return false

    end

    --==================================================
    -- PRINT HARGA
    --==================================================

    print(
        "[PET CHECK]",
        Pet.Name,
        "Price:",
        PetPrice
    )

    --==================================================
    -- JANGAN BELI JIKA HARGA >= 12 JUTA
    --==================================================

    if PetPrice >= MAX_PET_PRICE then

        print(
            "[SKIP PET]",
            Pet.Name,
            "Harga:",
            PetPrice,
            ">= Limit:",
            MAX_PET_PRICE
        )

        return false

    end

    --==================================================
    -- PET BOLEH DIBELI
    --==================================================

    print(
        "[BUY PET]",
        Pet.Name,
        "Harga:",
        PetPrice
    )

    --==================================================
    -- GET PLAYER ROOT
    --==================================================

    local HRP =
        GetRoot()

    --==================================================
    -- HITUNG JARAK
    --==================================================

    local Distance = (
        HRP.Position
        - RootPart.Position
    ).Magnitude

    --==================================================
    -- HITUNG DURASI TWEEN
    -- SPEED 100
    --==================================================

    local Duration =
        Distance / TWEEN_SPEED

    --==================================================
    -- TWEEN KE PET
    --==================================================

    local Tween =
        TweenService:Create(

            HRP,

            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    RootPart.CFrame
            }

        )

    Tween:Play()

    Tween.Completed:Wait()

    --==================================================
    -- CEK PET MASIH ADA
    --==================================================

    if not Pet
        or not Pet.Parent then

        return false

    end

    --==================================================
    -- CEK ROOTPART MASIH ADA
    --==================================================

    if not RootPart
        or not RootPart.Parent then

        return false

    end

    --==================================================
    -- PASTIKAN POSISI SUDAH DI PET
    --==================================================

    HRP.CFrame =
        RootPart.CFrame

    --==================================================
    -- FIRE BUY PROMPT
    --
    -- SETELAH PROMPT DIPANGGIL
    -- TIDAK AKAN MENGIKUTI PET LAGI
    --==================================================

    local Success =
        pcall(function()

            fireproximityprompt(
                BuyPrompt
            )

        end)

    --==================================================
    -- PROMPT BERHASIL DIPANGGIL
    --==================================================

    if Success then

        print(
            "[TAKE SUCCESS]",
            Pet.Name,
            "Price:",
            PetPrice
        )

        task.wait(
            AFTER_TAKE_DELAY
        )

        return true

    end

    --==================================================
    -- PROMPT GAGAL
    --==================================================

    warn(
        "[TAKE FAILED]",
        Pet.Name
    )

    return false

end

--==================================================
-- PROCESS SEMUA PET DALAM BATCH
--==================================================

local function ProcessBatch()

    if ProcessingBatch then

        return

    end

    if #Batch == 0 then

        return

    end

    ProcessingBatch = true

    --==================================================
    -- PROSES SATU PER SATU
    --==================================================

    while #Batch > 0 do

        local Pet =
            table.remove(
                Batch,
                1
            )

        --==================================================
        -- CEK PET MASIH VALID
        --==================================================

        if Pet
            and Pet.Parent then

            --==================================================
            -- TAKE / SKIP PET
            --==================================================

            TakePet(
                Pet
            )

            --==================================================
            -- LANJUT KE PET BERIKUTNYA
            --==================================================

            task.wait(
                AFTER_PROCESS_DELAY
            )

        end

    end

    ProcessingBatch = false

end

--==================================================
-- GET SEMUA PET YANG DIMILIKI
-- BACKPACK + CHARACTER
--==================================================

local function GetAllOwnedPets()

    local Pets = {}

    --==================================================
    -- GET BACKPACK
    --==================================================

    local Backpack =
        LocalPlayer:WaitForChild(
            "Backpack"
        )

    --==================================================
    -- SCAN BACKPACK
    --==================================================

    for _, Item in ipairs(
        Backpack:GetChildren()
    ) do

        if Item:GetAttribute(
            "Pet"
        ) ~= nil then

            table.insert(
                Pets,
                Item
            )

        end

    end

    --==================================================
    -- GET CHARACTER
    --==================================================

    local Character =
        LocalPlayer.Character

    --==================================================
    -- SCAN CHARACTER
    --==================================================

    if Character then

        for _, Item in ipairs(
            Character:GetChildren()
        ) do

            if Item:GetAttribute(
                "Pet"
            ) ~= nil then

                table.insert(
                    Pets,
                    Item
                )

            end

        end

    end

    return Pets

end

--==================================================
-- EQUIP PET
--==================================================

local function EquipPet(Pet)

    local Character =
        GetCharacter()

    --==================================================
    -- SUDAH EQUIP
    --==================================================

    if Pet.Parent
        == Character then

        return true

    end

    --==================================================
    -- HARUS ADA DI BACKPACK
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Backpack then

        return false

    end

    --==================================================
    -- GET HUMANOID
    --==================================================

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then

        return false

    end

    --==================================================
    -- EQUIP
    --==================================================

    Humanoid:EquipTool(
        Pet
    )

    --==================================================
    -- TUNGGU SAMPAI EQUIP
    --==================================================

    local StartTime =
        os.clock()

    while os.clock()
        - StartTime
        < EQUIP_TIMEOUT do

        if Pet.Parent
            == Character then

            return true

        end

        task.wait(
            0.1
        )

    end

    return false

end

--==================================================
-- DROP SATU PET
--==================================================

local function DropPet(Pet)

    if not Pet then

        return false

    end

    --==================================================
    -- GET PET ID
    --==================================================

    local PetId =
        Pet:GetAttribute(
            "PetId"
        )

    if not PetId then

        return false

    end

    --==================================================
    -- EQUIP JIKA MASIH DI BACKPACK
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Character then

        local Equipped =
            EquipPet(
                Pet
            )

        if not Equipped then

            return false

        end

    end

    --==================================================
    -- PASTIKAN SUDAH DI CHARACTER
    --==================================================

    if Pet.Parent
        ~= LocalPlayer.Character then

        return false

    end

    --==================================================
    -- REQUEST DROP
    --==================================================

    local Success =
        pcall(function()

            Networking
                .DroppedItem
                .RequestDrop
                :Fire(
                    "Pets",
                    PetId
                )

        end)

    if not Success then

        return false

    end

    --==================================================
    -- TUNGGU PET HILANG
    --==================================================

    local StartTime =
        os.clock()

    while os.clock()
        - StartTime
        < DROP_TIMEOUT do

        if not Pet.Parent then

            return true

        end

        task.wait(
            0.1
        )

    end

    return false

end

--==================================================
-- DROP SEMUA PET
--
-- RACCOON DI BACKPACK TIDAK DI-DROP
--==================================================

local function DropAllPets()

    --==================================================
    -- SCAN BACKPACK + CHARACTER
    --==================================================

    local Pets =
        GetAllOwnedPets()

    --==================================================
    -- TIDAK ADA PET
    --==================================================

    if #Pets == 0 then

        return

    end

    --==================================================
    -- DROP SATU PER SATU
    --==================================================

    for _, Pet in ipairs(
        Pets
    ) do

        if Pet
            and Pet.Parent then

            --==================================================
            -- GET NAMA PET
            --==================================================

            local PetName =
                Pet:GetAttribute(
                    "Pet"
                )

            --==================================================
            -- CEK RACCOON DI BACKPACK
            --==================================================

            local IsRaccoonInBackpack =
                PetName == "Raccoon"
                and Pet.Parent
                    == LocalPlayer.Backpack

            --==================================================
            -- JIKA BUKAN RACCOON DI BACKPACK
            -- DROP PET
            --==================================================

            if not IsRaccoonInBackpack then

                print(
                    "[DROP PET]",
                    PetName or Pet.Name
                )

                DropPet(
                    Pet
                )

                task.wait(
                    AFTER_DROP_DELAY
                )

            else

                print(
                    "[SKIP DROP] Raccoon di Backpack:",
                    Pet.Name
                )

            end

        end

    end

end

--==================================================
-- TWEEN KE CHARLOTTE
--
-- TARGET:
-- workspace.NPCS.Charlotte.HumanoidRootPart
--
-- SPEED:
-- 100
--==================================================

local function TweenToCenterMap()

    --==================================================
    -- CEGAH TWEEN GANDA
    --==================================================

    if TweeningToCenter then

        return

    end

    TweeningToCenter = true

    --==================================================
    -- GET PLAYER ROOT
    --==================================================

    local HRP =
        GetRoot()

    --==================================================
    -- GET CHARLOTTE
    --==================================================

    local Charlotte =
        workspace
        :WaitForChild(
            "NPCS"
        )
        :WaitForChild(
            "Charlotte"
        )

    --==================================================
    -- GET CHARLOTTE ROOT
    --==================================================

    local CharlotteRoot =
        Charlotte:WaitForChild(
            "HumanoidRootPart"
        )

    --==================================================
    -- HITUNG JARAK
    --==================================================

    local Distance = (
        HRP.Position
        - CharlotteRoot.Position
    ).Magnitude

    --==================================================
    -- JIKA SUDAH DEKAT
    --==================================================

    if Distance <= 2 then

        TweeningToCenter = false

        return

    end

    --==================================================
    -- HITUNG DURASI
    -- SPEED 100
    --==================================================

    local Duration =
        Distance / TWEEN_SPEED

    --==================================================
    -- TWEEN KE CHARLOTTE
    --==================================================

    local Tween =
        TweenService:Create(

            HRP,

            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),

            {
                CFrame =
                    CharlotteRoot.CFrame
            }

        )

    Tween:Play()

    Tween.Completed:Wait()

    --==================================================
    -- SELESAI
    --==================================================

    TweeningToCenter = false

end

--==================================================
-- PET BARU MASUK WILD PET SPAWNS
--==================================================

WildPetSpawns.ChildAdded:Connect(
    function(Pet)

        task.wait(
            0.1
        )

        AddToBatch(
            Pet
        )

    end
)

--==================================================
-- MAIN LOOP
--
-- TIDAK ADA SERVER HOP
--==================================================

while task.wait(
    CHECK_DELAY
) do

    --==================================================
    -- STEP 1
    -- SCAN SEMUA PET
    --==================================================

    ScanAllPets()

    --==================================================
    -- STEP 2
    -- TAKE PET
    --
    -- PET >= 12 JUTA AKAN DI-SKIP
    --==================================================

    ProcessBatch()

    --==================================================
    -- STEP 3
    -- DROP SEMUA PET
    --
    -- RACCOON DI BACKPACK AKAN DI-SKIP
    --==================================================

    DropAllPets()

    --==================================================
    -- STEP 4
    -- SCAN ULANG
    --==================================================

    ScanAllPets()

    --==================================================
    -- STEP 5
    -- JIKA TIDAK ADA PET
    -- TWEEN KE CHARLOTTE
    --==================================================

    if #WildPetSpawns:GetChildren() == 0
        and #Batch == 0
        and not ProcessingBatch then

        TweenToCenterMap()

    end

end
