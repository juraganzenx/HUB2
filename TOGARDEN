-- CLAIM ALL MAILBOX

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ReceiveFrame = LocalPlayer.PlayerGui.MailboxUI.Frame.RecieveFrame

for _, Gift in ipairs(ReceiveFrame:GetChildren()) do
    local ClaimButton = Gift:FindFirstChild("Claim", true)

    if ClaimButton and ClaimButton:IsA("TextButton") then
        print("Claiming:", Gift.Name)

        if firesignal then
            firesignal(ClaimButton.MouseButton1Click)
        else
            for _, conn in ipairs(getconnections(ClaimButton.MouseButton1Click)) do
                conn:Fire()
            end
        end

        task.wait(10)
    end
end
