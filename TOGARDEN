--CLAIM ALL MAILBOX
local ReceiveFrame = game.Players.LocalPlayer.PlayerGui.MailboxUI.Frame.RecieveFrame

for _, Gift in ipairs(ReceiveFrame:GetChildren()) do
    local ClaimButton = Gift:FindFirstChild("Claim", true)

    if ClaimButton and ClaimButton:IsA("TextButton") then
        print("Claiming:", Gift.Name)

        if firesignal then
            firesignal(ClaimButton.Activated)
        else
            for _, conn in ipairs(getconnections(ClaimButton.Activated)) do
                conn:Fire()
            end
        end

        task.wait(10)
    end
end
