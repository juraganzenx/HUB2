local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Networking = require(ReplicatedStorage.SharedModules.Networking)

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local USERNAME = "otmoonbloom1"

local CHECK_INTERVAL = 60
local MIN_WATERING_CAN = 2

--------------------------------------------------
-- GET USER ID
--------------------------------------------------

local Success, UserId = pcall(function()
	return Players:GetUserIdFromNameAsync(USERNAME)
end)

if not Success then
	warn("Gagal mendapatkan UserId.")
	return
end

--------------------------------------------------
-- GET ITEM COUNT
--------------------------------------------------

local function GetItemCount(ItemName)
	local Backpack = LocalPlayer:FindFirstChild("Backpack")

	if not Backpack then
		return 0
	end

	local Item = Backpack:FindFirstChild(ItemName)

	if not Item then
		return 0
	end

	local Count = Item:GetAttribute("Count")

	if typeof(Count) == "number" then
		return Count
	end

	return 0
end

--------------------------------------------------
-- ITEM CONFIG
--------------------------------------------------

local Items = {
	{
		Category = "WateringCans",
		ItemKey = "Super Watering Can"
	},

	{
		Category = "Sprinklers",
		ItemKey = "Super Sprinkler"
	},

	{
		Category = "Sprinklers",
		ItemKey = "Legendary Sprinkler"
	},

	{
		Category = "Sprinklers",
		ItemKey = "Rare Sprinkler"
	},

	{
		Category = "Sprinklers",
		ItemKey = "Uncommon Sprinkler"
	},

	{
		Category = "Sprinklers",
		ItemKey = "Common Sprinkler"
	}
}

--------------------------------------------------
-- TRADE FUNCTION
--------------------------------------------------

local function TryTrade()

	--------------------------------------------------
	-- CHECK SUPER WATERING CAN
	--------------------------------------------------

	local WateringCanCount = GetItemCount("Super Watering Can")

	if WateringCanCount < MIN_WATERING_CAN then
		return
	end

	--------------------------------------------------
	-- BUILD TRADE LIST
	--------------------------------------------------

	local TradeItems = {}

	for _, ItemData in ipairs(Items) do

		local Count = GetItemCount(ItemData.ItemKey)

		if Count > 0 then
			table.insert(TradeItems, {
				Category = ItemData.Category,
				ItemKey = ItemData.ItemKey,
				Count = Count
			})
		end

	end

	--------------------------------------------------
	-- CHECK TRADE LIST
	--------------------------------------------------

	if #TradeItems == 0 then
		return
	end

	--------------------------------------------------
	-- SEND ALL ITEMS
	--------------------------------------------------

	local SendSuccess, SendError = pcall(function()

		Networking.Mailbox.SendBatch:Fire(
			UserId,
			TradeItems,
			"rrr"
		)

	end)

	if SendSuccess then
		print(
			"Trade berhasil. Super Watering Can:",
			WateringCanCount
		)
	else
		warn(
			"Gagal mengirim:",
			SendError
		)
	end

end

--------------------------------------------------
-- CHECK INVENTORY EVERY 1 MINUTE
--------------------------------------------------

while true do

	TryTrade()

	task.wait(CHECK_INTERVAL)

end
